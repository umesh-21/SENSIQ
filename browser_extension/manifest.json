{
  "manifest_version": 3,
  "name": "PII Guard",
  "version": "1.3.0",
  "description": "Checks files you upload, drop or paste into web pages for personal details, on this computer only, and lets you send a safe copy instead.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true },
    { "matches": ["<all_urls>"], "js": ["page.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN" }
  ],
  "icons": { "128": "icon128.png" }
}